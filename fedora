ARG DIST="fedora"
ARG SUITE="42"
ARG QT_VERSION="6"
ARG REPOSITORY="hyperion-project"

FROM ghcr.io/${REPOSITORY}/qt6:latest AS qt6-bin
FROM ghcr.io/${REPOSITORY}/qemu:latest AS qemu-bin
FROM ghcr.io/${REPOSITORY}/cmake:latest AS cmake-bin

FROM ${DIST}:${SUITE}

ARG QT_VERSION
ARG TARGETPLATFORM

ENV TARGETPLATFORM=${TARGETPLATFORM:-linux/amd64}

# Update
RUN dnf -y update

# Install qt5 or qt6
RUN --mount=type=bind,from=qt6-bin,source=/qt6,target=/mnt/qt6 \
    if [ "$QT_VERSION" = "6" ]; then \
        dnf -y install libxkbcommon-devel; \
        sh /mnt/qt6/qt6-*.sh --skip-license --prefix=/usr --exclude-subdir; \
    else \
        dnf -y install qt5-qtbase-devel qt5-qtserialport-devel qt5-qtwebsockets-devel qt5-qtx11extras-devel; \
    fi

# Install general deps
RUN dnf -y group install 'development-tools' 'c-development' 'rpm-development-tools' && \
    dnf -y install \
    ninja-build \
    curl \
    patchelf \
    fedora-packager \
    python3-devel \
    python3-jsonschema \
    python3-jinja2 \
    libXrandr-devel \
    xcb-util-image-devel \
    xcb-util-devel \
    turbojpeg-devel \
    libjpeg-turbo-devel \
    libusb1-devel \
    avahi-libs \
    avahi-compat-libdns_sd-devel \
    dbus-devel \
    protobuf-devel \
    protobuf-compiler \
    flatbuffers-devel \
    flatbuffers-compiler \
    mbedtls-devel \
    openssl-devel \
    libcec-devel \
    alsa-lib-devel \
    libftdi-devel \
    systemd-devel \
    libdrm-devel \
    libatomic \
    pipewire-devel
    
# Mark /source as safe directory for git (used in CI mounts)
RUN git config --system --add safe.directory /source

# Install CMake
RUN --mount=type=bind,from=cmake-bin,source=/cmake,target=/mnt/cmake sh /mnt/cmake/cmake-*.sh --skip-license --prefix=/usr --exclude-subdir

# Show cmake version
RUN cmake --version

# rpmdev-setuptree will create the ~/rpmbuild directory and a set of subdirectories (e.g. SPECS and BUILD)
RUN rpmdev-setuptree

# Copy qemu and set QEMU_EXECVE / ENTRYPOINT
COPY --from=qemu-bin /qemu/qemu-static /usr/bin/qemu-static
ENV QEMU_EXECVE=/usr/bin/qemu-static
ENTRYPOINT [ "/usr/bin/qemu-static" ]

