ARG DIST="debian"
ARG SUITE="bookworm"
ARG REPOSITORY="hyperion-project"
ARG CMAKE_VERSION="4.4.3"
ARG QEMU_VERSION="11.1.1"
ARG DEBIAN_FRONTEND=noninteractive

FROM ghcr.io/${REPOSITORY}/qemu:${QEMU_VERSION} AS qemu-bin

FROM ${DIST}:${SUITE}

ARG DIST
ARG SUITE
ARG CMAKE_VERSION
ARG DEBIAN_FRONTEND
ARG TARGETPLATFORM

ENV TARGETPLATFORM=${TARGETPLATFORM:-linux/amd64}
ENV DEBFULLNAME="Hyperion Project"
ENV DEBEMAIL="admin@hyperion-project.org"

# update
RUN apt-get update

# install general deps (all platforms/arch/os)
RUN if [ "$SUITE" = "jammy" ]; then \
        SERIALPORT="libqt6serialport6-dev"; \
        WEBSOCKETS="libqt6websockets6-dev"; \
    else \
        SERIALPORT="qt6-serialport-dev"; \
        WEBSOCKETS="qt6-websockets-dev"; \
    fi; \
    apt-get -y install \
    qt6-base-dev \
    $SERIALPORT \
    $WEBSOCKETS \
    libqt6sql6-sqlite \
    libxkbcommon-dev \
    libvulkan-dev \
    libgl1-mesa-dev \
    devscripts \
    fakeroot \
    debhelper \
    libdistro-info-perl \
    git \
    curl \
    python3-dev \
    build-essential \
    ninja-build \
    python3-jsonschema \
    python3-jinja2 \    
    libusb-1.0-0-dev \
    libcec-dev \
    libp8-platform-dev \
    libudev-dev \
    libavahi-core-dev \
    libavahi-compat-libdnssd-dev \
    zlib1g-dev \
    libasound2-dev \
    libjpeg-dev \
    libturbojpeg0-dev \
    libmbedtls-dev \
    libftdi1-dev \
    libssl-dev \
    libglib2.0-dev \
    libdrm-dev \
    libpipewire-0.3-dev \
    libspa-0.2-dev

# Mark /source as safe directory for git (used in CI mounts)
RUN git config --system --add safe.directory /source

# install X11/XCB on Ubuntu for all arch and on Debian for amd64
# install libraspberrypi-dev on Debian for arm64/armhf
RUN if [ "$DIST" = "ubuntu" ] || [ "$TARGETPLATFORM" = "linux/amd64" ]; then \
    apt-get -y install libxcb-util0-dev libxcb-randr0-dev libxcb-shm0-dev libxcb-render0-dev libxcb-image0-dev libxrandr-dev libxrender-dev; \
elif [ "$TARGETPLATFORM" = "linux/arm64" ] || [ "$TARGETPLATFORM" = "linux/arm/v7" ] && [ "$SUITE" != "trixie" ]; then \
    apt-get -y install wget gpg dirmngr gpg-agent; \
    echo "deb http://archive.raspberrypi.org/debian ${SUITE} main ui" >> /etc/apt/sources.list.d/raspi.list; \
    apt-key adv --keyserver keyserver.ubuntu.com  --recv-key 0x82B129927FA3303E; \
    apt-get update && apt-get -y install libraspberrypi-dev; \
    rm /etc/apt/sources.list.d/raspi.list; \
fi

# Install CMake on amd64 and arm64
# Compile and install CMake on armv7
ENV CMAKE_URL="https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}"
RUN if [ "$TARGETPLATFORM" = "linux/amd64" ]; then \
    curl -OLs ${CMAKE_URL}-linux-x86_64.sh; \
    chmod +x cmake-${CMAKE_VERSION}-linux-x86_64.sh; \
    ./cmake-${CMAKE_VERSION}-linux-x86_64.sh --skip-license --prefix="/usr"; \
    rm -rf cmake-${CMAKE_VERSION}-linux-x86_64.sh; \
elif [ "$TARGETPLATFORM" = "linux/arm64" ]; then \
    curl -OLs ${CMAKE_URL}-linux-aarch64.sh; \
    chmod +x cmake-${CMAKE_VERSION}-linux-aarch64.sh; \
    ./cmake-${CMAKE_VERSION}-linux-aarch64.sh --skip-license --prefix="/usr"; \
    rm -rf cmake-${CMAKE_VERSION}-linux-aarch64.sh; \
else \
    mkdir -p /tmp/cmake; \
    cd /tmp/cmake; \
    curl -kL ${CMAKE_URL}.tar.gz | tar zxf - -C . --strip-components 1; \
    ./bootstrap --prefix=/usr; --parallel=`nproc`; \
    make -j `nproc`; \
    make install; \
    cd && rm -rf /tmp/cmake; \
fi

# Show cmake version
RUN cmake --version

# Copy qemu and set QEMU_EXECVE / ENTRYPOINT
RUN --mount=from=qemu-bin,source=/qemu,target=/qemu \
    case "$TARGETPLATFORM" in \
        linux/arm64) \
            cp /qemu/qemu-aarch64 /usr/bin/qemu-static ;; \
        linux/arm/v6|linux/arm/v7) \
            cp /qemu/qemu-arm /usr/bin/qemu-static ;; \
        *) \
            printf '#!/bin/sh\nexec "$@"\n' > /usr/bin/qemu-static ;; \
    esac && \
    chmod +x /usr/bin/qemu-static

ENV QEMU_EXECVE=/usr/bin/qemu-static
ENTRYPOINT [ "/usr/bin/qemu-static" ]
