# Default values for build arguments
ARG SUITE=bookworm
ARG REPOSITORY="hyperion-project"
ARG CMAKE_VERSION="4.4.3"
ARG QEMU_VERSION="11.1.1"

FROM --platform=linux/amd64 ghcr.io/${REPOSITORY}/qemu:${QEMU_VERSION} AS qemu-bin

# Base image with the Raspbian rootfs
FROM --platform=$BUILDPLATFORM debian:${SUITE}-slim AS raspbian-base

ARG SUITE

RUN --security=insecure \
    apt-get update && apt-get install -y --no-install-recommends ca-certificates curl gpgv xz-utils debootstrap qemu-user-static && \
    curl -fsSL "https://archive.raspbian.org/raspbian/pool/main/r/raspbian-archive-keyring/raspbian-archive-keyring_20120528.4_all.deb" -o /tmp/r.deb && \
    dpkg-deb -x /tmp/r.deb /tmp/r-key && \
    curl -fsSL "https://archive.raspberrypi.org/debian/pool/main/r/raspberrypi-archive-keyring/raspberrypi-archive-keyring_2025.1+rpt1_all.deb" -o /tmp/p.deb && \
    dpkg-deb -x /tmp/p.deb /tmp/p-key && \
    STAGING_SUITES=$(curl -fsSL "http://archive.raspbian.org/raspbian/dists/${SUITE}/Release" -o /tmp/release && { grep -qx "Suite: testing" /tmp/release && echo "--extra-suites=${SUITE}-staging" || true; }) && \
    debootstrap --keyring=/tmp/r-key/usr/share/keyrings/raspbian-archive-keyring.gpg --arch="armhf" --variant="minbase" ${STAGING_SUITES} "${SUITE}" /tmp/rootfs "http://archive.raspbian.org/raspbian/" && \
    install -D -m644 /tmp/r-key/usr/share/keyrings/raspbian-archive-keyring.gpg /tmp/rootfs/etc/apt/trusted.gpg.d/raspbian-archive-keyring.gpg && \
    install -D -m644 /tmp/p-key/usr/share/keyrings/raspberrypi-archive-keyring.gpg /tmp/rootfs/usr/share/keyrings/raspberrypi-archive-keyring.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/raspberrypi-archive-keyring.gpg] http://archive.raspberrypi.org/debian/ ${SUITE} main" > /tmp/rootfs/etc/apt/sources.list.d/raspi.list && \
    chroot /tmp/rootfs apt-get update && \
    rm -rf /tmp/r.deb /tmp/p.deb /tmp/r-key /tmp/p-key

# Final image
FROM scratch
COPY --from=raspbian-base /tmp/rootfs /

ARG SUITE
ARG REPOSITORY
ARG CMAKE_VERSION
ARG QEMU_VERSION
ARG DEBIAN_FRONTEND=noninteractive

# install deps
RUN apt-get -y install \
    qt6-base-dev \
    libqt6sql6-sqlite \
    qt6-serialport-dev \
    qt6-websockets-dev \
    libxkbcommon-dev \
    libvulkan-dev \
    libgl1-mesa-dev \
    devscripts \
    fakeroot \
    debhelper \
    libdistro-info-perl \
    git \
    curl \
    python3-dev \
    build-essential \
    ninja-build \
    python3-jsonschema \
    python3-jinja2 \
    libusb-1.0-0-dev \
    libcec-dev \
    libp8-platform-dev \
    libudev-dev \
    libavahi-core-dev \
    libavahi-compat-libdnssd-dev \
    zlib1g-dev \
    libasound2-dev \
    libjpeg-dev \
    libturbojpeg0-dev \
    libmbedtls-dev \
    libftdi1-dev \
    libssl-dev \
    libglib2.0-dev \
    libdrm-dev \
    libpipewire-0.3-dev \
    libspa-0.2-dev

RUN if [ "$SUITE" != "trixie" ] && [ "$SUITE" != "forky" ]; then \
    apt-get -y install --no-install-recommends libraspberrypi-dev; \
fi
    
# Mark /source as safe directory for git (used in CI mounts)
RUN git config --system --add safe.directory /source

# Compile and install CMake
ENV CMAKE_URL="https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}"
RUN mkdir -p /tmp/cmake; \
    cd /tmp/cmake; \
    curl -kL ${CMAKE_URL}.tar.gz | tar zxf - -C . --strip-components 1; \
    sed -i -e 's/|aarch64//g' Source/Checks/cm_cxx_features.cmake; \
    ./bootstrap --prefix=/usr --parallel=`nproc`; \
    make -j `nproc`; \
    make install; \
    cd && rm -rf /tmp/cmake

# Show cmake version
RUN cmake --version

# Copy qemu and set QEMU_EXECVE / ENTRYPOINT
COPY --from=qemu-bin /qemu/qemu-arm /usr/bin/qemu-static
ENV QEMU_EXECVE=/usr/bin/qemu-static
ENTRYPOINT [ "/usr/bin/qemu-static" ]
