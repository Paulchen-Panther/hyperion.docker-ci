# Default values for build arguments
ARG SUITE=bullseye
ARG QT_VERSION=6
ARG CMAKE_VERSION="3.28.3"

# Base image with the Raspbian rootfs
FROM --platform=$BUILDPLATFORM debian:${SUITE}-slim AS raspbian-base
ARG SUITE

RUN --security=insecure \
    apt-get update && apt-get install -y --no-install-recommends ca-certificates curl gpg debootstrap qemu-user-static && \
    curl -fsSL https://archive.raspbian.org/raspbian.public.key | gpg --dearmor > /tmp/raspbian.gpg && \
    curl -fsSL https://archive.raspberrypi.org/debian/raspberrypi.gpg.key | gpg --dearmor > /tmp/raspberrypi.gpg && \
    STAGING_SUITES=$(curl -fsSL "http://archive.raspbian.org/raspbian/dists/${SUITE}/Release" -o /tmp/release && { grep -qx "Suite: testing" /tmp/release && echo "--extra-suites=${SUITE}-staging" || true; }) && \
    debootstrap --keyring=/tmp/raspbian.gpg --arch="armhf" --variant="minbase" ${STAGING_SUITES} "${SUITE}" /tmp/rootfs "http://archive.raspbian.org/raspbian/" && \
    install -D -m 0644 /tmp/raspbian.gpg /tmp/rootfs/etc/apt/trusted.gpg.d/raspbian-archive-keyring.gpg && \
    install -D -m 0644 /tmp/raspberrypi.gpg /tmp/rootfs/usr/share/keyrings/raspberrypi-archive-keyring.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/raspberrypi-archive-keyring.gpg] http://archive.raspberrypi.org/debian/ ${SUITE} main" > /tmp/rootfs/etc/apt/sources.list.d/raspi.list && \
    chroot /tmp/rootfs apt-get update

# Final image
FROM scratch
COPY --from=raspbian-base /tmp/rootfs /

ARG SUITE
ARG QT_VERSION
ARG CMAKE_VERSION
ARG DEBIAN_FRONTEND=noninteractive

ENV QEMU_EXECVE=1

# install qt5 or qt6 (qt6 is not available on debian buster/bullseye)
RUN if ([ "$SUITE" = "bookworm" ] || [ "$SUITE" = "trixie" ] || [ "$SUITE" = "forky" ]) && [ "$QT_VERSION" = "6" ]; then \
    apt-get -y install qt6-base-dev libqt6sql6-sqlite qt6-serialport-dev qt6-websockets-dev libxkbcommon-dev libvulkan-dev libgl1-mesa-dev; \
else \
    apt-get -y install qtbase5-dev libqt5serialport5-dev libqt5websockets5-dev libqt5sql5-sqlite libqt5svg5-dev; \
fi

# install deps
RUN apt-get -y install \
    devscripts \
    fakeroot \
    debhelper \
    libdistro-info-perl \
    git \
    curl \
    python3-dev \
    build-essential \
    ninja-build \
    python3-jsonschema \
    python3-jinja2 \
    libusb-1.0-0-dev \
    libcec-dev \
    libp8-platform-dev \
    libudev-dev \
    libavahi-core-dev \
    libavahi-compat-libdnssd-dev \
    zlib1g-dev \
    libasound2-dev \
    libjpeg-dev \
    libturbojpeg0-dev \
    libmbedtls-dev \
    libftdi1-dev \
    libssl-dev \
    libglib2.0-dev \
    libdrm-dev \
    libpipewire-0.3-dev \
    libspa-0.2-dev

RUN if [ "$SUITE" != "trixie" ] && [ "$SUITE" != "forky" ]; then \
    apt-get -y install --no-install-recommends libraspberrypi-dev; \
fi
    
# Mark /source as safe directory for git (used in CI mounts)
RUN git config --system --add safe.directory /source

# Compile and install CMake
ENV CMAKE_URL="https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}"
RUN mkdir -p /tmp/cmake; \
    cd /tmp/cmake; \
    curl -kL ${CMAKE_URL}.tar.gz | tar zxf - -C . --strip-components 1; \
    sed -i -e 's/|aarch64//g' Source/Checks/cm_cxx_features.cmake; \
    ./bootstrap --prefix=/usr --parallel=`nproc`; \
    make -j `nproc`; \
    make install; \
    cd && rm -rf /tmp/cmake

# Show cmake version
RUN cmake --version

# download qemu and set exec flag
RUN curl -kL https://github.com/balena-io/qemu/releases/download/v7.0.0%2Bbalena1/qemu-7.0.0.balena1-arm.tar.gz | tar zxvf - -C . --strip-components 1 && mv qemu-arm-static /usr/bin/qemu-static

# set qemu exec flag
RUN chmod +x /usr/bin/qemu-static

# set entrypoint
ENTRYPOINT [ "/usr/bin/qemu-static" ]
